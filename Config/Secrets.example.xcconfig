// Copy this file to Config/Secrets.xcconfig (ignored by git)
// Then set these values in your active scheme's environment variables
// OR wire this xcconfig into target build configurations.
// In xcconfig files, literal `//` starts a comment, so URLs are built with `$(PARKSPOT_URL_SLASH)`.

PARKSPOT_URL_SLASH = /
PARKSPOT_API_URL = https:$(PARKSPOT_URL_SLASH)$(PARKSPOT_URL_SLASH)YOUR_PROJECT.supabase.co/functions/v1
PARKSPOT_OAUTH_CALLBACK_SCHEME = parkspot
PARKSPOT_PASSWORD_RESET_REDIRECT_URL = $(PARKSPOT_OAUTH_CALLBACK_SCHEME):$(PARKSPOT_URL_SLASH)$(PARKSPOT_URL_SLASH)reset-password
PARKSPOT_CHANGE_EMAIL_REDIRECT_URL = $(PARKSPOT_OAUTH_CALLBACK_SCHEME):$(PARKSPOT_URL_SLASH)$(PARKSPOT_URL_SLASH)change-email
// StoreKit attend des Product IDs (ex: com.xxx.yyy), pas les Apple IDs numériques.
// Référence ASC (Apple IDs): monthly=6765769380
PARKSPOT_PREMIUM_MONTHLY_PRODUCT_ID = com.mosimap.premium.monthly
PARKSPOT_PREMIUM_LIFETIME_PRODUCT_ID = com.mosimap.premium.lifetime
PARKSPOT_SUPPORT_EMAIL = support@mosimap.com
PARKSPOT_DATA_REQUEST_EMAIL = privacy@mosimap.com
PARKSPOT_PRIVACY_POLICY_URL = https:$(PARKSPOT_URL_SLASH)$(PARKSPOT_URL_SLASH)mosimap.com/privacy
PARKSPOT_TERMS_URL = https:$(PARKSPOT_URL_SLASH)$(PARKSPOT_URL_SLASH)mosimap.com/terms
